{
  "name": "price-tracker",
  "version": "1.0.0",
  "description": "Track product prices on Micro Center and get email alerts when price drops",
  "main": "price-tracker.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "check-price": "node price-tracker.js --check-price",
    "check-price:headed": "node price-tracker.js --check-price --headed",
    "dev": "node server.js",
    "track": "node price-tracker.js",
    "dry-run": "node price-tracker.js --dry-run"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "puppeteer": "^25.1.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "resend": "^4.0.0"
  },
  "allowScripts": {
    "puppeteer@25.1.0": true
  },
  "engines": {
    "node": ">=22.12"
  }
}
