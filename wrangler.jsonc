{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "price-tracker",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "browser": {"binding": "BROWSER"},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "price-tracker",
    // Replace this ID with the value from `npm run cf:db:create`.
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "cloudflare/migrations"
  }],
  "queues": {
    "producers": [{"binding": "CHECKS", "queue": "price-tracker-checks"}],
    "consumers": [{"queue": "price-tracker-checks", "max_batch_size": 1, "max_batch_timeout": 1, "max_concurrency": 1, "max_retries": 3}]
  },
  // Check for due/stalled work every five minutes; each product is due hourly.
  "triggers": {"crons": ["*/5 * * * *"]},
  "observability": {"enabled": true},
  "vars": {
    "ALLOWED_STORE_HOSTS": "microcenter.com,bestbuy.com,bhphotovideo.com,amazon.com,walmart.com,target.com,apple.com"
  }
}
